{
  "rewrites": [
    {
      "source": "/api/send",
      "destination": "https://api.znn.my.id/alightmotion/send-v2"
    },
    {
      "source": "/api/verify",
      "destination": "https://api.znn.my.id/alightmotion/verify"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}